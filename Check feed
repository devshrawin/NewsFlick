"""
Feed health check.

Pings every feed in feeds.yaml and writes reports/feed_check.md.
No API keys needed. Run via the 'Check feeds' workflow, then read the
report on your phone.

What we care about per feed:
  ALIVE?     did it return parseable entries
  FRESH?     how old is the newest entry (a feed stuck 3 days back is dead to us)
  STUB?      does the feed body carry full article text or a 2-line teaser
             (almost all will be STUB — that's expected, it's why we need
             an extraction step later)
"""

import re
import sys
import time
import statistics
from datetime import datetime, timezone
from pathlib import Path

import feedparser
import requests
import yaml

ROOT = Path(__file__).resolve().parent.parent
FEEDS_FILE = ROOT / "feeds.yaml"
REPORT_FILE = ROOT / "reports" / "feed_check.md"

UA = "newsdigest-feedcheck/0.1 (personal research project; contact via github.com/devshrawin)"
TIMEOUT = 25
STUB_THRESHOLD = 400  # chars of body text below which we call it a teaser


def strip_html(text: str) -> str:
    text = re.sub(r"<[^>]+>", " ", text or "")
    return re.sub(r"\s+", " ", text).strip()


def entry_body(entry) -> str:
    """Longest text blob the entry offers."""
    candidates = []
    if entry.get("summary"):
        candidates.append(entry["summary"])
    for c in entry.get("content", []) or []:
        if c.get("value"):
            candidates.append(c["value"])
    if not candidates:
        return ""
    return strip_html(max(candidates, key=len))


def entry_time(entry):
    for key in ("published_parsed", "updated_parsed"):
        t = entry.get(key)
        if t:
            try:
                return datetime.fromtimestamp(time.mktime(t), tz=timezone.utc)
            except (ValueError, OverflowError):
                pass
    return None


def check(name: str, url: str) -> dict:
    row = {
        "name": name,
        "url": url,
        "ok": False,
        "note": "",
        "entries": 0,
        "age_hours": None,
        "median_chars": 0,
        "dated": 0,
    }
    try:
        resp = requests.get(
            url, timeout=TIMEOUT, headers={"User-Agent": UA}, allow_redirects=True
        )
    except requests.RequestException as exc:
        row["note"] = f"{type(exc).__name__}"
        return row

    if resp.status_code != 200:
        row["note"] = f"HTTP {resp.status_code}"
        return row

    parsed = feedparser.parse(resp.content)
    entries = parsed.entries or []
    row["entries"] = len(entries)
    if not entries:
        row["note"] = "0 entries (not a feed? moved?)"
        return row

    bodies = [len(entry_body(e)) for e in entries]
    row["median_chars"] = int(statistics.median(bodies)) if bodies else 0

    times = [t for t in (entry_time(e) for e in entries) if t]
    row["dated"] = len(times)
    if times:
        newest = max(times)
        row["age_hours"] = round(
            (datetime.now(timezone.utc) - newest).total_seconds() / 3600, 1
        )

    row["ok"] = True
    if resp.url.rstrip("/") != url.rstrip("/"):
        row["note"] = "redirected"
    return row


def verdict(row: dict) -> str:
    if not row["ok"]:
        return "DEAD"
    if row["age_hours"] is None:
        return "NO DATES"
    if row["age_hours"] > 48:
        return "STALE"
    return "OK"


def main() -> int:
    feeds = yaml.safe_load(FEEDS_FILE.read_text())["feeds"]
    rows = []
    for f in feeds:
        print(f"checking {f['name']} ...", flush=True)
        rows.append(check(f["name"], f["url"]))
        time.sleep(1)  # be polite

    live = [r for r in rows if verdict(r) == "OK"]
    stubs = [r for r in live if r["median_chars"] < STUB_THRESHOLD]
    total_items = sum(r["entries"] for r in live)

    out = []
    out.append("# Feed check")
    out.append("")
    out.append(f"Run: {datetime.now(timezone.utc):%Y-%m-%d %H:%M} UTC")
    out.append("")
    out.append(f"- **{len(live)} / {len(rows)} feeds usable**")
    out.append(f"- {total_items} items visible right now across live feeds")
    out.append(f"- {len(stubs)} of {len(live)} live feeds are teaser-only "
               f"(<{STUB_THRESHOLD} chars) -> need article extraction")
    out.append("")
    out.append("Legend: OK / STALE (newest item >48h) / NO DATES / DEAD")
    out.append("")

    for group in ("OK", "STALE", "NO DATES", "DEAD"):
        chunk = [r for r in rows if verdict(r) == group]
        if not chunk:
            continue
        out.append(f"## {group} ({len(chunk)})")
        out.append("")
        for r in sorted(chunk, key=lambda x: x["name"]):
            bits = []
            if r["ok"]:
                bits.append(f"{r['entries']} items")
                if r["age_hours"] is not None:
                    bits.append(f"newest {r['age_hours']}h ago")
                bits.append(f"median body {r['median_chars']} chars")
                bits.append("FULL TEXT" if r["median_chars"] >= STUB_THRESHOLD else "teaser")
                if r["dated"] < r["entries"]:
                    bits.append(f"only {r['dated']}/{r['entries']} dated")
            if r["note"]:
                bits.append(r["note"])
            out.append(f"**{r['name']}** — {', '.join(bits)}")
            out.append(f"`{r['url']}`")
            out.append("")

    REPORT_FILE.parent.mkdir(parents=True, exist_ok=True)
    REPORT_FILE.write_text("\n".join(out))
    print(f"\nwrote {REPORT_FILE}  ({len(live)}/{len(rows)} usable)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
